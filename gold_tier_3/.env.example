# ============================================================
# Gold Tier AI Employee — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# Claude / Anthropic API
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Gmail (OAuth2) — used by GmailWatcher + email-mcp
# credentials.json and token.json must be in project root
# Download credentials.json from Google Cloud Console
# Run: node email-mcp/auth.js    (generates token.json)
# ------------------------------------------------------------
# No env vars needed — credentials.json handles auth

# CEO email for weekly briefing delivery
CEO_EMAIL=your.email@gmail.com

# ------------------------------------------------------------
# Odoo Community (Docker)
# Start: docker compose -f odoo/docker-compose.yml up -d
# ------------------------------------------------------------
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=gold_admin_2024
ODOO_DB_PASSWORD=odoo_gold_2024
ODOO_PORT=8069
ODOO_LONGPOLL_PORT=8072

# ------------------------------------------------------------
# Facebook + Instagram (Graph API)
# Get from: developers.facebook.com → Graph API Explorer
# Required permissions: pages_messaging, pages_manage_posts,
#   instagram_basic, instagram_manage_comments
# ------------------------------------------------------------
FB_PAGE_ACCESS_TOKEN=EAAxxxxx...
FB_PAGE_ID=123456789012345
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret

# Instagram Business Account ID
# Get: curl "https://graph.facebook.com/v19.0/{FB_PAGE_ID}?fields=instagram_business_account&access_token={FB_PAGE_ACCESS_TOKEN}"
IG_ACCOUNT_ID=17841400000000000

# ------------------------------------------------------------
# Twitter (X) API v2
# Get from: developer.twitter.com → Projects & Apps
# Required: OAuth 1.0a (for write) + OAuth 2.0 Bearer (for read)
# ------------------------------------------------------------
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAxxxxx
TWITTER_API_KEY=xxxxx
TWITTER_API_SECRET=xxxxx
TWITTER_ACCESS_TOKEN=xxxxx-xxxxx
TWITTER_ACCESS_TOKEN_SECRET=xxxxx
# Get your user ID: https://tweeterid.com or Twitter API /users/me
TWITTER_USER_ID=123456789
